# Copy/review in a private shell; never commit a filled credential file.
# Explicit paths avoid the snapshot's historical working-host fallbacks.
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
export HUMANENESS_PLAYGROUND_DATA="${HUMANENESS_PLAYGROUND_DATA:-$HOME/.cache/humaneness-playground}"
export HUMANENESS_RL_CACHE="$HUMANENESS_PLAYGROUND_DATA/rl/hub"
export HUMANENESS_EXPERIMENTAL_LARGE_CACHE="$HUMANENESS_PLAYGROUND_DATA/alpha/hub"
export HUMANENESS_SCORER_DIR="$HUMANENESS_PLAYGROUND_DATA/scorers"
export MOSS_ASSETS="$HUMANENESS_PLAYGROUND_DATA/loras"
export MOSS_PROFILE_LORAS="$MOSS_ASSETS/sft3_voice"
export MOSS_PROFILE_REFS="$HUMANENESS_PLAYGROUND_DATA/refs"
export MOSS_REF_DIR_OVERRIDE="$HUMANENESS_PLAYGROUND_DATA/refs"
export MOSS_REF3_DIR="$HUMANENESS_PLAYGROUND_DATA/refs3"
export MOSS_RETRIEVAL_DIR="$HUMANENESS_PLAYGROUND_DATA/retrieval"
export MOSS_WAV_CACHE="$HUMANENESS_PLAYGROUND_DATA/ref_wav_cache"
# Adjust the GPU index for your host. The source defaults to cuda:1.
export ACTING_DEVICE=cuda:0
export SMALL_SCORE_DEVICE=cuda:0
export SMALL_ALIGN_DEVICE=cuda:0
export SMALL_VC_DEVICE=cuda:0
export SMALL_REFERENCE_SECONDS=15
# Hosted provider defaults. Keep the secret outside this file.
export SMALL_LUNA_BASE=https://api.hyprlab.io
export SMALL_LUNA_MODEL=gpt-5.6-luna
# Export SMALL_LUNA_API_KEY in your shell/secret manager if using a director.
# Manual model prompts need no LLM credential.
